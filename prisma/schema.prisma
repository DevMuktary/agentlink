generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USERS
model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  
  firstName             String
  lastName              String
  businessName          String?
  phoneNumber           String?
  websiteUrl            String?
  role                  Role     @default(AGENT)
  
  walletBalance         Decimal  @default(0.00) @db.Decimal(10, 2)
  bonusBalance          Decimal  @default(0.00) @db.Decimal(10, 2)
  
  isActive              Boolean  @default(true)
  apiStatus             ApiStatus @default(NONE)

  apiKeyPublic          String?   @unique
  apiKeySecret          String?   @unique
  webhookUrl            String?
  ipWhitelist           String?

  virtualAccountName    String?
  virtualAccountNumber  String?
  virtualBankName       String? 
  paymentPointRef       String?

  transactions          Transaction[]
  requests              ServiceRequest[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// 2. SERVICES
model Service {
  id              String      @id @default(cuid())
  code            ServiceType @unique
  serviceCode     Int?        @unique
  name            String
  description     String?
  
  // Kept for migration safety
  price           Decimal     @default(0.00) @db.Decimal(10, 2) 
  
  // New dual pricing
  dashboardPrice  Decimal     @default(0.00) @db.Decimal(10, 2)
  apiPrice        Decimal     @default(0.00) @db.Decimal(10, 2)

  isDashboardActive Boolean @default(true)
  isApiActive       Boolean @default(true)
  
  isActive        Boolean     @default(true)

  updatedAt       DateTime    @updatedAt
}

// 3. DATA PLANS
model DataPlan {
  id              String   @id @default(cuid())
  network         String   
  category        String   
  name            String   
  
  // Kept for migration safety
  price           Decimal  @default(0.00) @db.Decimal(10, 2)
  
  // New dual pricing
  dashboardPrice  Decimal  @default(0.00) @db.Decimal(10, 2)
  apiPrice        Decimal  @default(0.00) @db.Decimal(10, 2)

  isDashboardActive Boolean @default(true)
  isApiActive       Boolean @default(true)
  
  productCode     String   @unique 
  validity        String?  
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 4. SERVICE REQUESTS
model ServiceRequest {
  id            String      @id @default(cuid())
  userId        String
  serviceType   ServiceType 
  status        Status      @default(PENDING) 
  
  requestData   Json   
  responseData  Json?
  cost          Decimal     @default(0.00) @db.Decimal(10, 2)
  adminNote     String?

  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([serviceType])
}

// 5. WALLET LOGS
model Transaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  reference   String          @unique
  status      Status          @default(PENDING)
  description String?
  serviceId   String?
  
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
}

// 6. VERIFICATION TOKENS
model VerificationToken {
  identifier String   
  token      String   
  expires    DateTime

  @@unique([identifier, token])
}

// --- ENUMS ---

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum ApiStatus {
  NONE
  PENDING
  APPROVED
  REVOKED
}

enum TransactionType {
  DEPOSIT
  SERVICE_CHARGE
  REFUND
  BONUS
  MANUAL_DEBIT
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

