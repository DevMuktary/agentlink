  NIN_SLIP_STANDARD
  NIN_SLIP_REGULAR
  
  NIN_MODIFICATION_NAME
  NIN_MODIFICATION_PHONE
  NIN_MODIFICATION_ADDRESS

  NIN_PERSONALIZATION
  VNIN_SLIP
  VNIN_TO_NIBSS
  IPE_CLEARANCE

  NIN_SLIP_V2_PREMIUM
  NIN_SLIP_V2_STANDARD
  NIN_SLIP_V2_REGULAR

  NIN_SLIP_V2_PHONE_PREMIUM
  NIN_SLIP_V2_PHONE_STANDARD
  NIN_SLIP_V2_PHONE_REGULAR

  // --- BVN SERVICES ---
  BVN_VERIFICATION
  BVN_PREMIUM_SLIP
  BVN_RETRIEVAL_PHONE
  BVN_RETRIEVAL_CRM
  ANDROID_BVN_ENROLLMENT
  BVN_RETRIEVAL
