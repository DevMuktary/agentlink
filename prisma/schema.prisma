generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USERS
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  
  firstName       String
  lastName        String
  businessName    String?
  phoneNumber     String?
  websiteUrl      String?
  role            Role     @default(AGENT)
  
  walletBalance   Decimal  @default(0.00) @db.Decimal(10, 2)
  bonusBalance    Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive        Boolean  @default(false)

  apiKeyPublic    String?  @unique
  apiKeySecret    String?  @unique
  webhookUrl      String?
  ipWhitelist     String?

// Add these for Virtual Accounts
  virtualAccountName    String?
  virtualAccountNumber  String?
  virtualBankName       String? 
  paymentPointRef       String? // To store customer_id from PaymentPoint

  transactions    Transaction[]
  requests        ServiceRequest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 2. SERVICES (Core Services like Verification, CAC, etc.)
model Service {
  id          String      @id @default(cuid())
  code        ServiceType @unique
  serviceCode Int?        @unique // Used for Manual options (e.g. 620)
  name        String
  description String?
  price       Decimal     @default(0.00) @db.Decimal(10, 2)
  isActive    Boolean     @default(true)

  updatedAt   DateTime    @updatedAt
}

// 3. DATA PLANS (New Model for 300+ Data Bundles)
model DataPlan {
  id            String   @id @default(cuid())
  network       String   // MTN, GLO, AIRTEL, 9MOBILE
  category      String   // SME, GIFTING, CORPORATE, AWOOF, ETC
  name          String   // e.g. MTN 1GB 30Days
  price         Decimal  @default(0.00) @db.Decimal(10, 2)
  productCode   String   @unique // The provider's code: mtn_sme_1gb
  validity      String?  // e.g. "30 Days"
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 4. SERVICE REQUESTS
model ServiceRequest {
  id            String      @id @default(cuid())
  userId        String
  serviceType   ServiceType 
  status        Status      @default(PENDING) 
  
  requestData   Json        
  responseData  Json?
  cost          Decimal     @default(0.00) @db.Decimal(10, 2)
  adminNote     String?

  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([serviceType])
}

// 5. WALLET LOGS
model Transaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  reference   String          @unique
  status      Status          @default(PENDING)
  description String?
  serviceId   String?
  
  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
}



// 6. VERIFICATION TOKENS (For OTPs)
model VerificationToken {
  identifier String   // Email
  token      String   // OTP
  expires    DateTime

  @@unique([identifier, token])
}

// --- ENUMS ---

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum TransactionType {
  DEPOSIT
  SERVICE_CHARGE
  REFUND
  BONUS
  MANUAL_DEBIT
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum ServiceType {
  // --- UTILITIES ---
  AIRTIME
  AIRTIME_MTN
  AIRTIME_GLO
  AIRTIME_AIRTEL
  AIRTIME_9MOBILE
  DATA
  
  // --- NIN SERVICES ---
  NIN_VERIFICATION       
  NIN_SEARCH_BY_PHONE 
  
  // VALIDATION TYPES
  NIN_VALIDATION_NO_RECORD
  NIN_VALIDATION_UPDATE_RECORD
  NIN_VALIDATION_VNIN
  
  // SLIP GENERATION
  NIN_SLIP_PREMIUM
  NIN_SLIP_STANDARD
  NIN_SLIP_REGULAR
  
  // MODIFICATION TYPES
  NIN_MODIFICATION_NAME
  NIN_MODIFICATION_PHONE
  NIN_MODIFICATION_ADDRESS

  // OTHER NIN
  NIN_PERSONALIZATION
  VNIN_SLIP
  VNIN_TO_NIBSS
  IPE_CLEARANCE

// --- NEW SLIPS (V2) - BY NIN ---
  NIN_SLIP_V2_PREMIUM
  NIN_SLIP_V2_STANDARD
  NIN_SLIP_V2_REGULAR

  // --- NEW SLIPS (V2) - BY PHONE ---
  NIN_SLIP_V2_PHONE_PREMIUM
  NIN_SLIP_V2_PHONE_STANDARD
  NIN_SLIP_V2_PHONE_REGULAR

  // --- BVN SERVICES ---
  BVN_VERIFICATION
  BVN_PREMIUM_SLIP
  BVN_RETRIEVAL_PHONE
  BVN_RETRIEVAL_CRM
  ANDROID_BVN_ENROLLMENT
  BVN_RETRIEVAL
  BVN_MODIFICATION

  // BVN MODIFICATION CATEGORIES (BILLABLE)
  BVN_MOD_NAME
  BVN_MOD_DOB
  BVN_MOD_PHONE
  BVN_MOD_NAME_DOB
  BVN_MOD_NAME_PHONE
  BVN_MOD_DOB_PHONE
  BVN_MOD_FULL

  // BVN BANKS (TOGGLES)
  BANK_AGENCY
  BANK_HERITAGE
  BANK_BOA
  BANK_NIBSS
  BANK_ENTERPRISE
  BANK_FIRSTBANK
  BANK_KEYSTONE
  BANK_FCMB
  
  // --- CORPORATE ---
  CAC_REGISTRATION
  JTB_TIN_REGISTRATION // Deprecated? Kept for safety
  TAX_ID_INDIVIDUAL
  TAX_ID_NON_INDIVIDUAL
  
  // --- EDUCATION ---
  JAMB_SERVICES
  EXAM_PIN_WAEC
  EXAM_PIN_NECO
  EXAM_PIN_NABTEB
  EXAM_PIN_JAMB
  EXAM_PIN_JAMB_UTME  // New
  EXAM_PIN_JAMB_DE    // New

// JAMB DIRECT SERVICES (Manual)
  JAMB_ORIGINAL_RESULT
  JAMB_ADMISSION_LETTER
  JAMB_REGISTRATION_SLIP
  JAMB_PROFILE_CODE_RETRIEVAL
}
